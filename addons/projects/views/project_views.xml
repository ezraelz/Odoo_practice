<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================== Extend Project Views ======================== -->
    
    <!-- Form View - Following hr_appraisal pattern -->
    <record id="project_project_view_form_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            
            <!-- Add Tasks stat button to button box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button"
                        name="%(project.act_project_project_2_project_task_all)d"
                        icon="fa-tasks"
                        type="action"
                        groups="project.group_project_user" 
                        context="{'search_default_project_id': id, 'default_project_id': id}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="task_count"/></span>
                        <span class="o_stat_text">Tasks</span>
                    </div>
                </button>
            </xpath>
            
            <!-- Add customer field after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_id" string="Customer" 
                       placeholder="Select customer"
                       options="{'no_create_edit': True}"
                       domain="[('is_company', '=', True)]"/>
            </xpath>
            
            <!-- Add status fields -->
            <xpath expr="//notebook/page[@name='settings']//group" position="after">
                <group string="Project Status" name="project_status" colspan="2">
                    <field name="task_progress" string="Progress" widget="progressbar"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- List/Tree View - Inherit and modify -->
    <record id="project_project_view_tree_inherit" model="ir.ui.view">
        <field name="name">project.project.tree.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
                <attribute name="sample">1</attribute>
            </xpath>
            
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="customer_id" string="Customer" optional="show"/>
                <field name="task_progress" string="Progress" widget="progressbar" optional="show"/>
            </xpath>
            
            <xpath expr="//list/field[@name='partner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            
            <xpath expr="//list/field[@name='date_start']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            
            <xpath expr="//list/field[@name='date']" position="attributes">
                <attribute name="string">End Date</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            
        </field>
    </record>

    <!-- Search View - Inherit and modify -->
    <record id="project_project_view_search_inherit" model="ir.ui.view">
        <field name="name">project.project.search.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="customer_id"/>
            </xpath>
            
            <xpath expr="//filter[@name='my_projects']" position="after">
                <separator/>
                <filter string="Creation Date" name="filter_create_date" date="create_date"/>
                <filter string="Start Date" name="filter_date_start" date="date_start"/>
                <filter string="End Date" name="filter_date_end" date="date"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </xpath>
            
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string='Customer' name="group_customer" context="{'group_by': 'customer_id'}"/>
                <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date'}"/>
                <filter string="Start Date" name="group_date_start" context="{'group_by': 'date_start'}"/>
                <filter string="End Date" name="group_date_end" context="{'group_by': 'date'}"/>
            </xpath>
            
        </field>
    </record>

    <!-- Kanban View - Inherit and modify -->
    <record id="project_project_view_kanban_inherit" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_view_kanban"/>
        <field name="arch" type="xml">
            
            <!-- Add fields to kanban -->
            <xpath expr="//kanban" position="inside">
                <field name="customer_id"/>
                <field name="task_progress"/>
                <field name="date"/>
                <field name="color"/>
            </xpath>
            
            <!-- Replace card template -->
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="kanban-box">
                    <div t_att_data-id="record.id.raw_value" class="oe_kanban_global_click">
                        <div class="o_kanban_record_top mb-2">
                            <div class="o_kanban_record_header">
                                <strong class="o_kanban_record_title">
                                    <t t-esc="record.name.value"/>
                                </strong>
                            </div>
                            <div t-if="record.customer_id.raw_value" class="text-muted">
                                <i class="fa fa-building-o"/> 
                                <t t-esc="record.customer_id.value"/>
                            </div>
                            <div t-if="record.user_id.raw_value" class="text-muted small">
                                <i class="fa fa-user"/> 
                                <t t-esc="record.user_id.value"/>
                            </div>
                        </div>
                        
                        <div class="o_kanban_record_content">
                            <div class="mt-2">
                                <span class="small">Progress:</span>
                                <div class="progress" style="height: 5px;">
                                    <div t-att-class="'progress-bar ' + (record.task_progress.raw_value ? 'bg-secondary' : 'bg-primary')"
                                        t-att-style="'width: %s%%;' % (record.task_progress.raw_value or 0)"
                                        role="progressbar"
                                        t-att-aria-valuenow="record.task_progress.raw_value or 0"
                                        aria-valuemin="0"
                                        aria-valuemax="100"/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="o_kanban_record_bottom mt-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    End: <t t-esc="record.date.value"/>
                                </small>
                            </div>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                    </div>
                </t>
            </xpath>
            
        </field>
    </record>

    <!-- Activity View - Inherit and modify -->
    <record id="project_project_view_activity" model="ir.ui.view">
        <field name="name">project.project.activity</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <activity string="Projects">
                <field name="name"/>
                <field name="customer_id"/>
                <templates>
                    <div t-name="activity-box">
                        <div class="ms-2">
                            <div>
                                <strong><t t-esc="record.name.value"/></strong>
                            </div>
                            <div t-if="record.customer_id" class="text-muted small">
                                <t t-esc="record.customer_id.display_value"/>
                            </div>
                            <div class="text-muted">
                                End Date: <t t-esc="record.date.value"/>
                            </div>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Calendar View - Inherit and modify -->
    <record id="project_project_view_calendar_inherit" model="ir.ui.view">
        <field name="name">project.project.calendar.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_calendar"/>
        <field name="arch" type="xml">
            
            <xpath expr="//calendar" position="inside">
                <field name="customer_id" invisible="1"/>
            </xpath>
            
        </field>
    </record>

    <!-- Main Action - Custom ID to avoid overriding core -->
    <record id="action_project_all_custom" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="context">{
            'search_default_my_projects': 1,
            'search_default_filter_open': 1,
        }</field>
    </record>

    <!-- Menu Items - Custom IDs to avoid conflicts -->
    <!-- <menuitem id="menu_project_main_custom" 
              name="Projects" 
              sequence="10"
              web_icon="project,static/description/icon.png"/>
    
    <menuitem id="menu_all_projects_custom"
              name="All Projects"
              parent="menu_project_main_custom"
              action="action_project_all_custom"
              sequence="10"
              groups="project.group_project_manager"/> -->

    <!-- ======================== Extend Task Views ======================== -->
    
    <!-- Task Form View -->
    <record id="project_task_view_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
    </record>

    <!-- Task Search View -->
    <record id="project_task_view_search_inherit" model="ir.ui.view">
        <field name="name">project.task.search.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
    </record>

    <!-- Task List View - Inherit and modify -->
    <record id="project_task_view_tree_inherit" model="ir.ui.view">
        <field name="name">project.task.list.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            
        </field>
    </record>

    <!-- Server Actions -->

    <record id="action_mark_completed" model="ir.actions.server">
        <field name="name">Mark as Completed</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">list,form,kanban</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
# Call the dedicated method instead of direct write
records.action_approve_done()
]]></field>
    </record>
</odoo>