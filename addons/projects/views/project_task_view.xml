<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ======================== List View ======================== -->
    <record id="view_task_list_refined" model="ir.ui.view">
        <field name="name">project.task.list.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">stage_id.is_done</attribute>
                <attribute name="decoration-danger">
                    date_deadline &lt; current_date and not stage_id.is_done
                </attribute>
                <attribute name="default_order">sequence, date_deadline</attribute>
            </xpath>

            <xpath expr="//list/field[@name='name']" position="after">
                <field name="project_id"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="stage_id" widget="badge" readonly="1"
                    domain="[('project_ids','in',[project_id])]"/>
                <field name="date_deadline"/>
            </xpath>

            <xpath expr="//list/field[@name='stage_id']" position="after">
                <field name="progress" widget="progressbar" groups="project.group_project_manager,base.group_system"/>
            </xpath>
        </field>
    </record>

    <!-- ======================== Form View ======================== -->
    <record id="view_task_form_refined" model="ir.ui.view">
        <field name="name">project.task.form.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- Ribbons -->
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon"
                        title="Completed"
                        bg_color="bg-info"
                        invisible="not stage_id.is_completed"/>

                <widget name="web_ribbon"
                        title="Done"
                        bg_color="bg-success"
                        invisible="not stage_id.is_done"/>
            </xpath>

            <!-- Fields -->
            <xpath expr="//sheet/group[1]" position="inside">
                <field name="user_ids"
                       widget="many2many_avatar_user"
                       options="{'no_create': True}"/>
                <field name="description_admin" groups="project.group_project_manager,base.group_system"/>
                <field name="progress" widget="progressbar" groups="project.group_project_manager,base.group_system"/>
            </xpath>

            <!-- Assigner-only approval button -->
            <xpath expr="//header" position="inside">
                <button name="action_approve_done"
                        type="object"
                        string="Approve &amp; Move to Done"
                        class="btn-primary"
                        invisible="
                            not stage_id.is_completed
                            or create_uid != uid
                        "/>
            </xpath>

        </field>
    </record>

    <!-- ======================== Kanban View ======================== -->
    <record id="view_task_kanban_refined" model="ir.ui.view">
        <field name="name">project.task.kanban.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">

            <xpath expr="//kanban" position="inside">
                <field name="project_id"/>
                <field name="stage_id" widget="badge"
                     domain="[('project_ids','in',[project_id])]"/>
            </xpath>

            <xpath expr="//templates/t[@t-name='card']" position="inside">
                <div>
                    <field name="progress" widget="progressbar"/>
                </div>
            </xpath>

            <xpath expr="//templates/t[@t-name='card']" position="inside">
                <t t-if="record.stage_id.value and record.stage_id.value.is_completed">
                    <span class="badge bg-info">Completed</span>
                </t>
                <t t-if="record.stage_id.value and record.stage_id.value.is_done">
                    <span class="badge bg-success">Done</span>
                </t>
            </xpath>

        </field>
    </record>

    <!-- ======================== Action ======================== -->
    <record id="action_my_tasks" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="domain">[('user_ids','in',[uid])]</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="context">
            {'search_default_filter_my_tasks': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task!
            </p>
            <p>
                Tasks help you break down projects into manageable pieces.
            </p>
        </field>
    </record>
    <record id="action_all_tasks" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="domain">['|', ('user_ids','in',[uid]), ('id','=',0)]</field>
        <field name="context">{'show_all_if_admin': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task!
            </p>
            <p>
                Tasks help you break down projects into manageable pieces.
            </p>
        </field>
    </record>

    <!-- ======================== Refine Search View ======================== -->
    <record id="view_task_search_inherit_refined" model="ir.ui.view">
        <field name="name">project.task.search.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_tasks']" position="attributes">
                <attribute name="domain">[('user_ids','in',[uid])]</attribute>
                <attribute name="string">My Tasks</attribute>
            </xpath>
        </field>
    </record>

    <!-- ======================== Refine Calendar View ======================== -->
    <record id="view_task_calendar_inherit_refined" model="ir.ui.view">
        <field name="name">project.task.calendar.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="color">project_id</attribute>
                <attribute name="string">Task Calendar</attribute>
            </xpath>
        </field>
    </record>

    <!-- ======================== Refine Graph View ======================== -->
    <record id="view_task_graph_inherit_refined" model="ir.ui.view">
        <field name="name">project.task.graph.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_project_task_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//graph" position="attributes">
                <attribute name="string">Task Analysis</attribute>
                <attribute name="type">bar</attribute>
                <attribute name="stacked">True</attribute>
            </xpath>
            <!--
            <xpath expr="//graph/field[@name='id']" position="attributes">
                <attribute name="string">Number of Tasks</attribute>
            </xpath>
            -->
        </field>
    </record>
 
    <!-- ======================== Refine Pivot View ======================== -->
    <record id="view_task_pivot_inherit_refined" model="ir.ui.view">
        <field name="name">project.task.pivot.refined</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_project_task_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="attributes">
                <attribute name="string">Task Analysis</attribute>
                <attribute name="disable_linking">True</attribute>
                <attribute name="display_quantity">1</attribute>
            </xpath>
            <!--
            <xpath expr="//pivot/field[@name='id']" position="attributes">
                <attribute name="string">Number of Tasks</attribute>
            </xpath>
            -->
        </field>
    </record>

    <!-- ======================== Activity View ======================== -->
    <record id="view_task_activity_refined" model="ir.ui.view">
        <field name="name">project.task.activity.refined</field>
        <field name="model">project.task</field>
        <field name="type">activity</field>
        <field name="arch" type="xml">
            <activity string="Task Activities">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_ids"/>
                <field name="date_deadline"/>
                <field name="stage_id" readonly="1"/>
            </activity>
        </field>
    </record>

    <!-- ======================== Task Stages ======================== -->
    <record id="project_task_stage_new" model="project.task.type">
        <field name="name">Backlog</field>
        <field name="sequence">10</field>
        <field name="fold">False</field>
        <field name="is_done">False</field>
    </record>

    <record id="project_task_stage_in_progress" model="project.task.type">
        <field name="name">In Progress</field>
        <field name="sequence">20</field>
        <field name="fold">False</field>
        <field name="is_done">False</field>
    </record>

    <record id="project_task_stage_review" model="project.task.type">
        <field name="name">On hold</field>
        <field name="sequence">30</field>
        <field name="fold">True</field>
        <field name="is_done">False</field>
    </record>

    <record id="project_task_completed" model="project.task.type">
        <field name="name">Completed</field>
        <field name="sequence">40</field>
        <field name="fold">True</field>
        <field name="is_completed">True</field>
        <field name="is_done">False</field>
    </record>

    <record id="project_task_stage_done" model="project.task.type">
        <field name="name">Done</field>
        <field name="sequence">50</field>
        <field name="fold">True</field>
        <field name="is_done">True</field>
    </record>

    <record id="project_task_stage_done_final" model="project.task.type">
        <field name="name">Done stage</field>
        <field name="sequence">60</field>
        <field name="fold">True</field>
        <field name="is_done">True</field>
    </record>
    
    <!-- ======================== Automated Actions ======================== -->
    <record id="automatic_action_notify_overdue" model="ir.actions.server">
        <field name="name">Notify Overdue Tasks</field>
        <field name="model_id" ref="model_project_task"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
overdue_tasks = self.search([
    ('date_deadline', '<', fields.Date.today()),
    ('stage_id.is_done', '=', False),
    ('user_ids', '!=', False)
])
for task in overdue_tasks:
    task.message_post(
        body=f"Task {task.name} is overdue!",
        partner_ids=task.user_ids.partner_id.ids,
        message_type='notification'
    )
]]></field>
    </record>
</odoo>