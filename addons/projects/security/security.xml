<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Groups with custom category -->
    <record id="group_project_user_own" model="res.groups">
        <field name="name">Project: Own Tasks Only</field>
        <field name="category_id" ref="module_category_custom_projects"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_project_user_all" model="res.groups">
        <field name="name">Project: All Tasks</field>
        <field name="category_id" ref="module_category_custom_projects"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_project_admin" model="res.groups">
        <field name="name">Project: Administrator</field>
        <field name="category_id" ref="module_category_custom_projects"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_manager')), (4, ref('project.group_project_user'))]"/>
    </record>
    <!-- Create custom category for our groups -->
    <record id="module_category_custom_projects" model="ir.module.category">
        <field name="name">Custom Projects</field>
        <field name="description">Custom Project Management Extensions</field>
        <field name="sequence">15</field>
        <field name="visible" eval="True"/>
    </record>
</odoo>