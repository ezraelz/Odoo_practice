<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- PROJECT RULES -->
    <!-- ===================================================== -->

    <!-- Own Projects Only -->
    <record id="project_project_own_rule" model="ir.rule">
        <field name="name">Project: Own Projects Only</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="groups" eval="[(4, ref('group_project_user_own'))]"/>
        <field name="domain_force">
            [('create_uid', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>

    <!-- All Projects -->
    <record id="project_project_all_rule" model="ir.rule">
        <field name="name">Project: All Projects</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="groups" eval="[
            (4, ref('group_project_user_all')),
            (4, ref('group_project_admin'))
        ]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>


    <!-- ===================================================== -->
    <!-- TASK RULES -->
    <!-- ===================================================== -->

    <!-- Own Tasks Only -->
    <record id="project_task_own_rule" model="ir.rule">
        <field name="name">Task: Own Tasks Only</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('group_project_user_own'))]"/>
        <field name="domain_force">
            ['|', ('user_ids','in',[user.id]), ('create_uid','=',user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>

    <!-- All Tasks -->
    <record id="project_task_all_rule" model="ir.rule">
        <field name="name">Task: All Tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[
            (4, ref('group_project_user_all')),
            (4, ref('group_project_admin'))
        ]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>


</odoo>