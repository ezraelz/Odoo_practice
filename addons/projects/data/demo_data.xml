<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Stages Demo Data -->
    <record id="task_stage_todo" model="pro.task.stage">
        <field name="name">To Do</field>
        <field name="sequence">10</field>
        <field name="fold">False</field>
        <field name="is_done">False</field>
    </record>

    <record id="task_stage_in_progress" model="pro.task.stage">
        <field name="name">In Progress</field>
        <field name="sequence">20</field>
        <field name="fold">False</field>
        <field name="is_done">False</field>
    </record>

    <record id="task_stage_done" model="pro.task.stage">
        <field name="name">Done</field>
        <field name="sequence">30</field>
        <field name="fold">True</field>
        <field name="is_done">True</field>
    </record>

    <!-- Sample Project -->
    <record id="demo_project_1" model="pro.project">
        <field name="name">Website Redesign</field>
        <field name="description">Redesign company website with modern UI</field>
        <field name="customer_id" ref="base.res_partner_1"/>
        <field name="start_date">2026-01-01</field>
        <field name="end_date">2026-03-31</field>
        <field name="state">in_progress</field>
    </record>

    <!-- Sample Tasks -->
    <record id="demo_task_1" model="pro.task">
        <field name="name">Design Homepage</field>
        <field name="project_id" ref="demo_project_1"/>
        <field name="stage_id" ref="task_stage_in_progress"/>
        <field name="assigned_to" ref="base.user_admin"/>
        <field name="due_date">2026-01-15</field>
    </record>

    <record id="demo_task_2" model="pro.task">
        <field name="name">Create Wireframes</field>
        <field name="project_id" ref="demo_project_1"/>
        <field name="stage_id" ref="task_stage_todo"/>
        <field name="assigned_to" ref="base.user_demo"/>
        <field name="due_date">2026-01-30</field>
    </record>
</odoo>